# 南京审计大学校园网认证凭据模板
# 复制本文件为 .env 并填入实际账号密码即可：cp .env.example .env

# 校园网账号（通常为学号）
NAU_USERNAME=your_student_id

# 校园网认证密码
NAU_PASSWORD=your_password

# 校园网门户认证服务器 IP
# 2026-11 网络改造后为 Dr.COM 哆点网关：10.255.252.12
# 旧自服务门户（改造前）：10.255.254.23 —— 仍可达但不再认可新 DHCP 地址，仅供回滚
NAU_PORTAL_IP=10.255.252.12

# 认证后端：auto（按门户首页指纹自动识别）| drcom（哆点 /drcom/login）| legacy（旧 /api/portal/v1/login）
NAU_AUTH_TYPE=auto

# 认证域（旧门户专用，默认：default）
NAU_DOMAIN=default

# 外网 204 探针检测地址（用于验证真实网络通畅度）
NAU_DETECT_URL=http://connect.rom.miui.com/generate_204
