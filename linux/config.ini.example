# ========================================================
# NAU-AutoLogin Linux 保活守护配置 (树莓派 / 单无线链路场景)
# 凭据 (学号/密码) 不在本文件: 复制根目录 .env.example 为 .env 填写
# 部署: sudo ./deploy/install.sh (配置落位 ~/.nau-autologin/config.ini)
# ========================================================

[portal]
# 校园网门户认证服务器 IP (南审默认 10.255.254.23; 环境变量 NAU_PORTAL_IP 可覆盖)
portal_ip = 10.255.254.23

# 保活/检测周期（秒）: 断网后按该周期重试登录, 登录失败时指数退避 (上限 300s)
check_interval = 30

# 外网 204 探针地址: 超时或被 302 劫持到门户即判定掉线 (环境变量 NAU_DETECT_URL 可覆盖)
detect_url = http://connect.rom.miui.com/generate_204
