# ========================================================
# NAU-AutoLogin Linux 保活守护配置 (树莓派 / 单无线链路场景)
# 凭据 (学号/密码) 不在本文件: 复制根目录 .env.example 为 .env 填写
# 部署: sudo ./deploy/install.sh (配置落位 ~/.nau-autologin/config.ini)
# ========================================================

[portal]
# 校园网门户认证服务器 IP (2026-11 网络改造后南审为 10.255.252.12 哆点;
# 旧自服务门户 10.255.254.23; 环境变量 NAU_PORTAL_IP 可覆盖)
portal_ip = 10.255.252.12

# 认证后端: auto 按门户首页指纹自动识别 | drcom (哆点 /drcom/login) | legacy (旧 /api/portal/v1/login)
auth_type = auto

# 保活/检测周期（秒）: 断网后按该周期重试登录, 登录失败时指数退避 (上限 300s)
check_interval = 30

# 外网 204 探针地址: 超时或被 302 劫持到门户即判定掉线 (环境变量 NAU_DETECT_URL 可覆盖)
detect_url = http://connect.rom.miui.com/generate_204

# IPv6 备用探针: 仅在上面 v4 探针失败时补测一次 (环境变量 NAU_DETECT_URL_V6 可覆盖)
# 2026-11-19 实测 v4 上游 12%~14% 丢包 / 200ms+ RTT, 而 v6 0 丢包 / 16ms;
# 留空则禁用 v6 补测 (v4 失败即视为掉线)
detect_url_v6 = http://cp.cloudflare.com/generate_204
